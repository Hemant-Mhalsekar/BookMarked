# Leave both empty in development: Vite proxies /api to http://localhost:8080.

# Base for normal API calls. Keep it /api (the default) when the host proxies /api to the API,
# as vercel.json does, so the login cookie stays first-party.
VITE_API_URL=

# Production only: the API's own address + /api, e.g. https://bookmarked-api.onrender.com/api
# E-book uploads and PDF streams go here directly instead of through the frontend host's proxy.
VITE_DIRECT_API_URL=
